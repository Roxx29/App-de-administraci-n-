{
  "name": "apex-ledger",
  "productName": "ApexLedger",
  "version": "0.1.0",
  "description": "Administración para pymes: productos, inventario, ventas, facturas y exportación a Excel.",
  "main": "main.js",
  "author": "ApexLedger",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/logica.test.js",
    "build:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.apexledger.app",
    "files": ["main.js", "preload.js", "src/**/*", "!src/**/*.test.js"],
    "directories": { "output": "dist" },
    "win": { "signAndEditExecutable": false },
    "portable": { "artifactName": "ApexLedger-${version}.exe" }
  }
}
