{
  "name": "apex-ledger",
  "productName": "ApexLedger",
  "version": "0.3.0",
  "description": "Administración para pymes: productos, inventario, ventas, facturas y exportación a Excel.",
  "main": "main.js",
  "author": "ApexLedger",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/logica.test.js src/idiomas.test.js",
    "build:win": "electron-builder --win portable --x64",
    "build:win:linux": "electron-builder --win portable --x64 -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.apexledger.app",
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "src/**/*",
      "!src/**/*.test.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ApexLedger-${version}.exe"
    }
  }
}
